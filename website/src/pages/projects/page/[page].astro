---
import ProjectListing, { PAGE_SIZE } from '../../../components/ProjectListing.astro';
import { snapshot } from '../../../lib/snapshot.mjs';
export function getStaticPaths() {
  const count = Math.ceil(snapshot.discovery.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, count - 1) }, (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } }));
}
const { page } = Astro.props;
---
<ProjectListing page={page} />
