---
import SiteLayout from './SiteLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { snapshot } from '../lib/snapshot.mjs';
export const PAGE_SIZE = 12;
const { page = 1 } = Astro.props;
const projects = snapshot.discovery;
const pageCount = Math.max(1, Math.ceil(projects.length / PAGE_SIZE));
const shown = projects.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageUrl = (number) => number === 1 ? '/projects/' : `/projects/page/${number}/`;
---
<SiteLayout title="Explore projects">
  <section class="directory-hero container" aria-labelledby="directory-title"><div class="eyebrow"><span class="eyebrow__line"></span> From the workbench</div><div class="directory-hero__grid"><h1 id="directory-title">Discover what people are <em>building.</em></h1><div class="directory-hero__aside"><p>Projects and products shared in Hacker News “What are you working on?” discussions, organized for discovery.</p><span class="hero-mark" aria-hidden="true">↘</span></div></div></section>
  <section class="directory container" aria-labelledby="directory-heading" data-directory data-version={snapshot.pointer.version} data-page-size={PAGE_SIZE}><div class="section-heading"><div><span class="eyebrow eyebrow--small">The directory</span><h2 id="directory-heading">Latest shared projects</h2></div><p data-total-count>{projects.length} {projects.length === 1 ? 'project' : 'projects'} published</p></div>
    <div class="discovery-controls" data-controls hidden><div class="search-wrap"><label for="project-search">Search projects</label><input id="project-search" type="search" placeholder="Search projects, problems, people…" autocomplete="off" /></div><div class="filter-row"><fieldset data-filter="category"><legend>Category</legend><div class="filter-options"></div></fieldset><fieldset data-filter="audience"><legend>Audience</legend><div class="filter-options"></div></fieldset><fieldset data-filter="looking"><legend>Looking for</legend><div class="filter-options"></div></fieldset><button class="clear-button" type="button" data-clear>Clear all</button></div><p class="result-count" data-result-count role="status" aria-live="polite"></p></div>
    <div data-results>{projects.length === 0 ? <div class="empty-state"><span class="empty-state__mark" aria-hidden="true">✳</span><h3>Nothing on the shelf yet.</h3><p>Approved projects will appear here after the first public snapshot is staged.</p></div> : <div class="project-list">{shown.map((project, index) => <ProjectCard project={project} index={(page - 1) * PAGE_SIZE + index + 1} />)}</div>}</div>
    <div data-pagination>{pageCount > 1 && <nav class="pagination" aria-label="Project pages"><a class={page === 1 ? 'pagination__disabled' : ''} href={page > 1 ? pageUrl(page - 1) : undefined} aria-disabled={page === 1 ? 'true' : undefined}>← Previous</a><span>Page {page} of {pageCount}</span><a class={page === pageCount ? 'pagination__disabled' : ''} href={page < pageCount ? pageUrl(page + 1) : undefined} aria-disabled={page === pageCount ? 'true' : undefined}>Next →</a></nav>}</div>
  </section>
  <dialog class="project-modal" data-project-modal aria-label="Project details"><div class="modal-bar"><button type="button" data-modal-close aria-label="Close project details">← Back to results</button></div><div data-modal-content></div></dialog>
</SiteLayout>
<script>import { initDiscovery } from '../scripts/discovery.mjs'; initDiscovery();</script>
