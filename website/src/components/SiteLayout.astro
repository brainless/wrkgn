---
import '../styles/global.css';
import DiscoveryControls from './DiscoveryControls.astro';
const { title, directory = false, description = 'Explore projects and products shared in Hacker News “What are you working on?” discussions.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet" /><title>{title} · wrkgn</title></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="site-sidebar" aria-label="Project navigation"><a class="wordmark" href="/" aria-label="wrkgn, browse projects">wrkgn<span class="wordmark__dot">.</span></a><DiscoveryControls directory={directory} /></aside>
    <header class="site-header"><div class="site-header__inner container"><a class="wordmark" href="/" aria-label="wrkgn, browse projects">wrkgn<span class="wordmark__dot">.</span></a><nav aria-label="Primary"><button type="button" class="nav-filters" data-filters-toggle aria-controls="directory-filters" aria-expanded="false" hidden={directory}>Filters</button></nav></div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid"><div><div class="wordmark footer-wordmark">wrkgn<span class="wordmark__dot">.</span></div><p>Ideas in progress, shared in the open.</p><a href="https://github.com/brainless/wrkgn">wrkgn on GitHub</a></div><p class="footer-notice">An independent directory of projects shared on Hacker News. Project materials belong to their respective rights holders. Summaries and categories are generated or edited for discovery and may contain errors. Inclusion does not imply endorsement or a current invitation to collaborate.</p></div></footer>
    <noscript><style>@media(max-width:767px){.site-sidebar .discovery-controls:not([hidden]){display:block!important}}</style></noscript>
  </body>
</html>
<script>
  const toggle = document.querySelector('[data-filters-toggle]');
  const sidebar = document.querySelector('.site-sidebar');
  const close = sidebar.querySelector('[data-filters-close]');
  const mobile = matchMedia('(max-width:767px)');
  const background = document.querySelectorAll('.skip-link, .site-header, main, .site-footer');
  let savedScrollY = 0;

  function setFiltersOpen(open) {
    if (open === sidebar.hasAttribute('data-mobile-filters-open')) return;
    if (open) {
      savedScrollY = window.scrollY;
      document.body.style.setProperty('--filter-scroll-offset', `-${savedScrollY}px`);
    }
    sidebar.toggleAttribute('data-mobile-filters-open', open);
    document.body.classList.toggle('mobile-filters-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    background.forEach((node) => { node.inert = open; });
    if (open) {
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
      sidebar.querySelector('#project-search')?.focus({ preventScroll: true });
    } else {
      sidebar.removeAttribute('role');
      sidebar.removeAttribute('aria-modal');
      document.body.style.removeProperty('--filter-scroll-offset');
      window.scrollTo({ top: savedScrollY, behavior: 'instant' });
      (mobile.matches ? toggle : sidebar.querySelector('#project-search'))?.focus({ preventScroll: true });
    }
  }

  toggle?.addEventListener('click', () => setFiltersOpen(!sidebar.hasAttribute('data-mobile-filters-open')));
  close?.addEventListener('click', () => setFiltersOpen(false));
  mobile.addEventListener('change', () => { if (!mobile.matches) setFiltersOpen(false); });
  sidebar.addEventListener('keydown', (event) => {
    if (!sidebar.hasAttribute('data-mobile-filters-open')) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setFiltersOpen(false);
    }
    if (event.key === 'Tab') {
      const items = [...sidebar.querySelectorAll('a[href], button, input')].filter((node) => node.getClientRects().length && !node.disabled);
      const first = items[0];
      const last = items.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>
