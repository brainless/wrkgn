---
import { projectTitle, safeWebUrl, sharedDate, categoryLabel } from '../lib/display.mjs';
import { snapshot } from '../lib/snapshot.mjs';
const { project, detail, related = [] } = Astro.props;
---
<article class="project-detail">
  <div class="detail-kicker"><span>Project record</span><span>{String(detail.mentions.length).padStart(2, '0')} {detail.mentions.length === 1 ? 'mention' : 'mentions'}</span></div>
  <header class="detail-header"><div class="eyebrow eyebrow--small">Originally shared on Hacker News</div><h1>{projectTitle(project)}</h1><p class="detail-lead">{project.description}</p><div class="detail-summary-meta"><span>Last shared <time datetime={new Date(project.latest_shared_at * 1000).toISOString()}>{sharedDate(project.latest_shared_at)}</time></span>{project.audience && <span>For {project.audience}</span>}</div></header>
  <div class="detail-layout"><div class="detail-main">
    {project.problem && <section class="detail-section" aria-labelledby="problem-heading"><div class="section-number">01 / The problem</div><h2 id="problem-heading">What it addresses</h2><p>{project.problem}</p></section>}
    <section class="detail-section" aria-labelledby="mentions-heading"><div class="section-number">{project.problem ? '02' : '01'} / Source history</div><h2 id="mentions-heading">Shared over time</h2><p class="section-intro">Each entry reflects what was shared on that date. Details may have changed since then.</p>
      <ol class="mention-list">{detail.mentions.map((mention) => <li class="mention"><div class="mention__date"><time datetime={new Date(mention.shared_at * 1000).toISOString()}>{sharedDate(mention.shared_at)}</time></div><div class="mention__content">
        <h3>{mention.name?.trim() || projectTitle(project)}</h3><p>{mention.description}</p>{mention.problem && <p><strong>Problem:</strong> {mention.problem}</p>}{mention.audience && <p><strong>Audience:</strong> {mention.audience}</p>}
        <p class="attribution">Posted by {mention.author ? <span>@{mention.author}</span> : 'an unattributed HN account'} · <a href={mention.source_url} rel="noopener noreferrer">Original comment ↗</a></p>
        {mention.source_excerpt && <blockquote class="source-excerpt">“{mention.source_excerpt}”</blockquote>}
        {mention.links.length > 0 && <div class="mention__links"><span class="meta-label">Links shared</span><ul>{mention.links.map((link) => { const safe = safeWebUrl(link); return safe && <li><a href={safe} rel="noopener noreferrer">{new URL(safe).hostname} ↗</a></li>; })}</ul></div>}
      </div></li>)}</ol>
    </section>
  </div><aside class="detail-aside" aria-label="Project discovery details"><div class="aside-block"><h2>Explore this project</h2>{project.categories.length > 0 && <div><span class="meta-label">Categories · editorial classification</span><div class="tag-row">{project.categories.map((category) => <span class="tag">{categoryLabel(category, snapshot.manifest.categories)}</span>)}</div></div>}{project.audience_labels.length > 0 && <div><span class="meta-label">Audience · editorial classification</span><div class="tag-row">{project.audience_labels.map((audience) => <span class="tag">{categoryLabel(audience, snapshot.manifest.audiences || [])}</span>)}</div></div>}</div>{project.builder_usernames.length > 0 && <div class="aside-block"><h2>Builders</h2><p>{project.builder_usernames.map((builder, index) => <span>{index > 0 ? ', ' : ''}@{builder}</span>)}</p></div>}{related.length > 0 && <div class="aside-block"><h2>Also shared by this builder</h2><ul class="related-list">{related.map((item) => <li><a href={`/projects/${item.slug}/`}>{projectTitle(item)} <span aria-hidden="true">↗</span></a></li>)}</ul></div>}</aside></div>
</article>
