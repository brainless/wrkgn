# Copy to .env and fill in one provider's credentials. Shell variables override this file.
WRKGN_PROVIDER=neuralwatt
NEURALWATT_API_KEY=replace-with-your-key
# WRKGN_MODEL=glm-5.3-flash
# NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1

# To use OpenAI instead, set WRKGN_PROVIDER=openai, OPENAI_API_KEY,
# and WRKGN_MODEL to an OpenAI completion model name.
# WRKGN_DB_PATH=local-data/wrkgn.sqlite
# WRKGN_EXPORT_PATH=local-data/public-export
